rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Keep media in the two application-owned collections. The project ID is
    // the only authorization boundary; do not grant access to arbitrary paths
    // below projects/{projectId}.
    function isProjectMember(projectId) {
      return request.auth != null &&
        firestore.exists(
          /databases/(default)/documents/projects/$(projectId)
        ) &&
        request.auth.uid in firestore.get(
          /databases/(default)/documents/projects/$(projectId)
        ).data.members;
    }

    function isValidUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024;
    }

    match /projects/{projectId}/photos/{filename} {
      allow read: if isProjectMember(projectId);
      allow write: if isProjectMember(projectId) && isValidUpload();
    }

    match /projects/{projectId}/library/{filename} {
      allow read: if isProjectMember(projectId);
      allow write: if isProjectMember(projectId) && isValidUpload();
    }
  }
}
