rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Photos are organized as: projects/{projectId}/photos/{filename}
    match /projects/{projectId}/{allPaths=**} {
      // Allow read if user is a project member
      allow read: if request.auth != null && 
                     request.auth.uid in firestore.get(/databases/(default)/documents/projects/$(projectId)).data.members;
      
      // Allow write if user is a project member
      // Limit file size to 10MB
      allow write: if request.auth != null && 
                      request.auth.uid in firestore.get(/databases/(default)/documents/projects/$(projectId)).data.members &&
                      request.resource.size < 10 * 1024 * 1024;
    }
  }
}
