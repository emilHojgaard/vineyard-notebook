rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId) {
      return signedIn() && request.auth.uid in project(projectId).members;
    }

    // Atomic project creation writes the project and its initial records in one
    // batch. get() sees only the committed database, while getAfter() includes
    // the batch's final project document for these create checks.
    function projectAfter(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMemberAfter(projectId) {
      return signedIn() && request.auth.uid in projectAfter(projectId).members;
    }

    function isProjectOwner(projectId) {
      return isProjectMember(projectId) &&
        (request.auth.uid == project(projectId).createdBy ||
         request.auth.uid in project(projectId).owners);
    }

    function invitationAfter(invitationId) {
      return getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data;
    }

    function hasSameAcceptanceMarker() {
      return (!resource.data.keys().hasAll(['lastAcceptedInvitationId']) &&
              !request.resource.data.keys().hasAll(['lastAcceptedInvitationId'])) ||
        (resource.data.keys().hasAll(['lastAcceptedInvitationId']) &&
         request.resource.data.keys().hasAll(['lastAcceptedInvitationId']) &&
         resource.data.lastAcceptedInvitationId == request.resource.data.lastAcceptedInvitationId);
    }

    // An invitee can add only their own UID, and only in the same atomic write
    // that accepts the invitation named by the project marker. The marker is
    // intentionally persisted as an audit value: without an invitation ID in
    // the project write, rules cannot correlate two arbitrary document writes.
    function isInvitationMembershipUpdate(projectId) {
      return signedIn() &&
        request.resource.data.keys().hasAll(['lastAcceptedInvitationId']) &&
        request.resource.data.lastAcceptedInvitationId is string &&
        request.resource.data.lastAcceptedInvitationId != '' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members', 'memberAddedAt', 'lastAcceptedInvitationId'
        ]) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        ((!resource.data.keys().hasAll(['owners']) && !request.resource.data.keys().hasAll(['owners'])) ||
         (resource.data.keys().hasAll(['owners']) && request.resource.data.keys().hasAll(['owners']) &&
          request.resource.data.owners == resource.data.owners)) &&
        validProjectMembershipDocument(request.resource.data) &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        !(request.auth.uid in resource.data.members) &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.memberAddedAt.keys().hasAll(resource.data.memberAddedAt.keys()) &&
        request.resource.data.memberAddedAt.size() == resource.data.memberAddedAt.size() + 1 &&
        request.resource.data.memberAddedAt.keys().hasAll([request.auth.uid]) &&
        invitationAfter(request.resource.data.lastAcceptedInvitationId).projectId == projectId &&
        invitationAfter(request.resource.data.lastAcceptedInvitationId).status == 'accepted' &&
        invitationAfter(request.resource.data.lastAcceptedInvitationId).acceptedBy == request.auth.uid &&
        invitationAfter(request.resource.data.lastAcceptedInvitationId).email == request.auth.token.email.trim().lower() &&
        (invitationAfter(request.resource.data.lastAcceptedInvitationId).invitedBy == resource.data.createdBy ||
         (resource.data.keys().hasAll(['owners']) &&
          invitationAfter(request.resource.data.lastAcceptedInvitationId).invitedBy in resource.data.owners));
    }

    function isInvitationAcceptance(invitationId) {
      return signedIn() &&
        resource.data.status == 'pending' &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.invitedBy == resource.data.invitedBy &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedBy == request.auth.uid &&
        request.resource.data.acceptedAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedBy', 'acceptedAt'
        ]) &&
        isInvitationRecipient(resource.data) &&
        getAfter(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.lastAcceptedInvitationId == invitationId &&
        getAfter(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members.hasAll([request.auth.uid]);
    }

    function isProjectBeingDeleted(projectId) {
      return project(projectId).keys().hasAll(['deleting']) &&
        project(projectId).deleting == true;
    }

    function isInvitationRecipient(invitation) {
      return signedIn() && request.auth.token.email != null &&
        request.auth.token.email.trim().lower() == invitation.email;
    }

    function validProjectMembershipDocument(data) {
      return data.members.size() > 0 &&
        data.createdBy in data.members &&
        (!data.keys().hasAll(['owners']) ||
         (data.owners.size() > 0 && data.owners.hasOnly(data.members))) &&
        (!data.keys().hasAll(['memberAddedAt']) ||
         data.memberAddedAt.keys().hasOnly(data.members));
    }

    match /projects/{projectId} {
      // This predicate is intentionally based on the document being listed.
      // A query using array-contains can then be proven safe by Firestore;
      // looking up the same document with get() is not query-provable.
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.createdBy &&
        request.auth.uid in request.resource.data.members &&
        validProjectMembershipDocument(request.resource.data);
      // Membership additions are allowed only by the rules-guarded invitation
      // transaction below. A browser owner may only remove existing members or
      // change ownership of existing members; this prevents arbitrary injection.
      allow update: if isInvitationMembershipUpdate(projectId) ||
        (isProjectOwner(projectId) &&
         validProjectMembershipDocument(request.resource.data) &&
         request.resource.data.createdBy in resource.data.members &&
         resource.data.members.hasAll(request.resource.data.members) &&
         hasSameAcceptanceMarker());
      allow delete: if isProjectOwner(projectId);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /seasons/{seasonId} {
      // Missing season documents intentionally are not readable: there is no
      // resource projectId to authorize. The repository therefore creates a
      // season with a write-only transaction and reads only existing seasons.
      allow read: if isProjectMember(resource.data.projectId);
      // A season is created only in the current state and its document ID is
      // bound to its project partition and year/title.
      allow create: if isProjectMemberAfter(request.resource.data.projectId) &&
        request.resource.data.status == 'current' &&
        request.resource.data.revision == 1 &&
        seasonId == request.resource.data.projectId + '_' + request.resource.data.title;
      // Completed seasons are immutable. Re-opening one, changing its
      // partition key, or writing a non-current status is rejected server-side.
      allow update: if isProjectMember(resource.data.projectId) &&
        resource.data.projectId == request.resource.data.projectId &&
        seasonId == request.resource.data.projectId + '_' + request.resource.data.title &&
        ((!resource.data.keys().hasAll(['revision']) && request.resource.data.revision == 1) ||
         request.resource.data.revision == resource.data.revision + 1) &&
        request.resource.data.keys().hasAll(['structure', 'content']) &&
        !request.resource.data.keys().hasAll(['root']) &&
        (!resource.data.keys().hasAll(['structure', 'content']) ||
         !resource.data.locked ||
         request.resource.data.structure == resource.data.structure) &&
        resource.data.status == 'current' &&
        (request.resource.data.status == 'current' ||
         request.resource.data.status == 'completed');
      // Project owners may remove a season as part of deleting their project;
      // ordinary season deletion still respects the season lock.
      allow delete: if (isProjectOwner(resource.data.projectId) &&
        isProjectBeingDeleted(resource.data.projectId)) ||
        (isProjectMember(resource.data.projectId) &&
         resource.data.status == 'current' &&
         !resource.data.locked);
    }

    match /inventory/{inventoryId} {
      // As with seasons, creation uses a write-only transaction because a
      // missing document has no projectId available to the read predicate.
      allow read: if isProjectMember(resource.data.projectId);
      // Inventory is partitioned by project and year. The season gate also
      // prevents writes after the corresponding season is archived.
      allow create: if isProjectMemberAfter(request.resource.data.projectId) &&
        inventoryId == request.resource.data.projectId + '_' + string(request.resource.data.year) &&
        request.resource.data.revision == 1 &&
        request.resource.data.keys().hasAll(['structure']) &&
        getAfter(/databases/$(database)/documents/seasons/$(inventoryId)).data.status == 'current';
      allow update: if isProjectMember(resource.data.projectId) &&
        resource.data.projectId == request.resource.data.projectId &&
        inventoryId == request.resource.data.projectId + '_' + string(request.resource.data.year) &&
        ((!resource.data.keys().hasAll(['revision']) && request.resource.data.revision == 1) ||
         request.resource.data.revision == resource.data.revision + 1) &&
        (!resource.data.keys().hasAll(['structure']) ||
         !get(/databases/$(database)/documents/seasons/$(inventoryId)).data.locked ||
         request.resource.data.structure == resource.data.structure) &&
        get(/databases/$(database)/documents/seasons/$(inventoryId)).data.status == 'current';
      // The owner also needs to remove inventory while deleting the project,
      // even when the corresponding season was locked.
      allow delete: if (isProjectOwner(resource.data.projectId) &&
        isProjectBeingDeleted(resource.data.projectId)) ||
        (isProjectMember(resource.data.projectId) &&
         !get(/databases/$(database)/documents/seasons/$(inventoryId)).data.locked &&
         get(/databases/$(database)/documents/seasons/$(inventoryId)).data.status == 'current');
    }

    match /library/{projectId} {
      allow read, delete: if isProjectMember(projectId);
      allow create: if isProjectMemberAfter(projectId) &&
        request.resource.data.projectId == projectId &&
        request.resource.data.revision == 1;
      allow update: if isProjectMember(projectId) &&
        request.resource.data.projectId == projectId &&
        ((!resource.data.keys().hasAll(['revision']) && request.resource.data.revision == 1) ||
         request.resource.data.revision == resource.data.revision + 1) &&
        (resource.data.projectId == projectId || !resource.data.keys().hasAll(['projectId']));
    }

    match /invitations/{invitationId} {
      allow read: if isProjectOwner(resource.data.projectId) ||
        isInvitationRecipient(resource.data);
      allow create: if isProjectOwner(request.resource.data.projectId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.email == request.resource.data.email.trim().lower();
      // Invitation state is not a client-controlled membership operation.
      // Owners can only cancel; invitees can only decline their own invite.
      allow update: if isInvitationAcceptance(invitationId) ||
        (isProjectOwner(resource.data.projectId) &&
         request.resource.data.projectId == resource.data.projectId &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.invitedBy == resource.data.invitedBy &&
         request.resource.data.status == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'projectName', 'createdAt', 'status'
         ]));
      allow delete: if isProjectOwner(resource.data.projectId) ||
        isInvitationRecipient(resource.data);
    }

    // Calendar token documents are server-managed; the HTTP feed performs a
    // second, live membership check for the token owner.
    match /calendar_tokens/{token} {
      allow read, write: if false;
    }
  }
}
