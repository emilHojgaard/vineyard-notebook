rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId) {
      return signedIn() && request.auth.uid in project(projectId).members;
    }

    function isProjectOwner(projectId) {
      return isProjectMember(projectId) &&
        (request.auth.uid == project(projectId).createdBy ||
         request.auth.uid in project(projectId).owners);
    }

    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.createdBy &&
        request.auth.uid in request.resource.data.members;
      // Membership and ownership are security-sensitive and can only be
      // changed by an existing owner. Owners may promote other members.
      allow update: if isProjectOwner(projectId) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isProjectOwner(projectId);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /seasons/{seasonId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isProjectMember(request.resource.data.projectId);
      allow update, delete: if isProjectMember(resource.data.projectId);
    }

    match /inventory/{inventoryId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isProjectMember(request.resource.data.projectId);
      allow update, delete: if isProjectMember(resource.data.projectId);
    }

    match /library/{projectId} {
      allow read, delete: if isProjectMember(projectId);
      allow create, update: if isProjectMember(projectId);
    }

    match /invitations/{invitationId} {
      allow read: if isProjectOwner(resource.data.projectId) ||
        (signedIn() && request.auth.token.email == resource.data.email);
      allow create: if isProjectOwner(request.resource.data.projectId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.invitedBy == request.auth.uid;
      allow update, delete: if isProjectOwner(resource.data.projectId);
    }

    match /calendar_tokens/{token} {
      allow read, write: if false;
    }
  }
}
